# PostgreSQL (Neon / Supabase / Vercel Postgres). Use the pooled URL on Vercel.
DATABASE_URL="postgresql://user:password@host:5432/jhaubon?sslmode=require"

# Signs admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# First admin user and payment numbers, used once by `npm run db:seed`.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""
SEED_BKASH_NUMBER=""
SEED_NAGAD_NUMBER=""

# Optional: SMS gateway for new-booking alerts (see src/lib/notify.ts).
SMS_API_URL=""
SMS_API_KEY=""
FRONT_DESK_PHONE=""
